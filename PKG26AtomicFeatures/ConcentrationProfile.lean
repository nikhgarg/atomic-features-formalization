      halternativeFactors sourceSupport hsourceSupport
  refine ⟨alternativeSupport.1, alternativeSupport.2, ?_⟩
  rw [← map_mulVecLin_coordinateSpan_eq_columnSpan]
  exact hspan

/-- Source-model wrapper for the exact active-block capacity bound. -/
theorem weighted_active_block_bound_of_kRich_and_factorizations
    {X : Type*} {d M M' K K' : ℕ}
    (matrix : Matrix (Fin d) (Fin M) ℝ)
    (z : X → FeatureVector M) (f : X → RepresentationVector d)
    (alternative : Matrix (Fin d) (Fin M') ℝ)
    (alternativeCode : X → FeatureVector M')
    (hrich : KRich (K := K) z)
    (hfactors : ∀ x, f x = matrix.mulVec (z x))
    (halternativeSparse : KSparse (K := K') alternativeCode)
    (halternativeFactors : ∀ x,
      f x = alternative.mulVec (alternativeCode x)) :
    M.choose K ≤
      ∑ block ∈ activeSourceAtomBlocks matrix alternative (min K' M') K,
        block.card.choose K := by
  apply choose_le_sum_activeSourceAtomBlocks_choose_of_sparse_subspace_cover
    matrix alternative (Nat.min_le_right _ _)
  intro sourceSupport hsourceSupport
  obtain ⟨alternativeSupport, hspan⟩ :=
    exists_sparse_alternative_subspace_containing_coordinate_image
      matrix z f alternative alternativeCode hrich hfactors
      (kSparse_min_columnCount alternativeCode halternativeSparse)
      halternativeFactors sourceSupport hsourceSupport
  refine ⟨alternativeSupport.1, alternativeSupport.2, ?_⟩
  rw [← map_mulVecLin_coordinateSpan_eq_columnSpan]
  exact hspan

/-- Source-model wrapper for the active-block worst-case concentration bound. -/
theorem concentration_active_block_choose_bound_of_kRich_and_factorizations
    {X : Type*} {d M M' K K' : ℕ}
    (matrix : Matrix (Fin d) (Fin M) ℝ)
    (z : X → FeatureVector M) (f : X → RepresentationVector d)
    (alternative : Matrix (Fin d) (Fin M') ℝ)
    (alternativeCode : X → FeatureVector M')
    (hrich : KRich (K := K) z)
    (hfactors : ∀ x, f x = matrix.mulVec (z x))
    (halternativeSparse : KSparse (K := K') alternativeCode)
    (halternativeFactors : ∀ x,
      f x = alternative.mulVec (alternativeCode x)) :
    M.choose K ≤
      (activeSourceAtomBlocks matrix alternative (min K' M') K).card *
        (sourceConcentration matrix (min K' M')).choose K := by
  exact (weighted_active_block_bound_of_kRich_and_factorizations
    matrix z f alternative alternativeCode hrich hfactors
      halternativeSparse halternativeFactors).trans
    (by
      apply sum_activeSourceAtomBlocks_choose_le_card_mul_concentration_choose
        matrix alternative (Nat.min_le_right _ _)
      intro sourceSupport hsourceSupport
      obtain ⟨alternativeSupport, hspan⟩ :=
        exists_sparse_alternative_subspace_containing_coordinate_image
          matrix z f alternative alternativeCode hrich hfactors
          (kSparse_min_columnCount alternativeCode halternativeSparse)
          halternativeFactors sourceSupport hsourceSupport
      refine ⟨alternativeSupport.1, alternativeSupport.2, ?_⟩
      rw [← map_mulVecLin_coordinateSpan_eq_columnSpan]
      exact hspan)

