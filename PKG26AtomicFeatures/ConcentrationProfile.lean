/-- Under source full spark, every positive rich factorization forces the
alternative dictionary to have full ambient rank.  This records the complete
linear-algebra chain `d ≤ rank(A') ≤ M'`, stronger than the width-only floor. -/
theorem full_spark_alternative_rank_bounds_of_kRich_and_factorizations
    {X : Type*} {d M M' K K' : ℕ}
    (matrix : Matrix (Fin d) (Fin M) ℝ)
    (z : X → FeatureVector M) (f : X → RepresentationVector d)
    (alternative : Matrix (Fin d) (Fin M') ℝ)
    (alternativeCode : X → FeatureVector M')
    (hspark : spark matrix = d + 1)
    (hKpos : 0 < K) (hK_le_M : K ≤ M)
    (hrich : KRich (K := K) z)
    (hfactors : ∀ x, f x = matrix.mulVec (z x))
    (halternativeSparse : KSparse (K := K') alternativeCode)
    (halternativeFactors : ∀ x,
      f x = alternative.mulVec (alternativeCode x)) :
    d ≤ Module.finrank ℝ (columnSpan alternative Finset.univ) ∧
      Module.finrank ℝ (columnSpan alternative Finset.univ) ≤ M' := by
  have hsource_rank :
      Module.finrank ℝ (columnSpan matrix Finset.univ) = d := by
    rw [finrank_columnSpan_eq_min_card_of_full_spark matrix hspark]
    simp only [Finset.card_univ, Fintype.card_fin]
    exact Nat.min_eq_right
      (ambient_dimension_le_column_count_of_spark_eq matrix hspark)
  have hrank :=
    source_dictionary_rank_le_alternative_rank_of_kRich_and_factorizations
      matrix z f alternative alternativeCode hKpos hK_le_M hrich hfactors
        halternativeSparse halternativeFactors
  rw [hsource_rank] at hrank
  refine ⟨hrank, ?_⟩
  simpa using finrank_columnSpan_le_card alternative
    (Finset.univ : Finset (Fin M'))

/-- Source-model concentration theorem.  Richness and the two sparse
factorizations alone give the exact covering-number sandwich at the effective
alternative width `min K' M'`; no spark, full-rank, or support-compatibility
premise is used. -/
theorem concentration_profile_bounds_of_kRich_and_factorizations
    {X : Type*} {d M M' K K' : ℕ}
    (matrix : Matrix (Fin d) (Fin M) ℝ)
    (z : X → FeatureVector M) (f : X → RepresentationVector d)
