/-- Exact full-spark scalar form of part (a), including the dimension-limited
regime: a source richness level `K` forces effective alternative rank-sparsity
at least `min K d`. -/
theorem min_sourceSparsity_dimension_le_min_alternativeSparsity_rank_full_spark
    {X : Type*} {d M M' K K' : ℕ}
    (matrix : Matrix (Fin d) (Fin M) ℝ)
    (z : X → FeatureVector M) (f : X → RepresentationVector d)
