    (halternativeSparse : KSparse (K := K') alternativeCode)
    (halternativeFactors : ∀ x,
      f x = alternative.mulVec (alternativeCode x)) :
    sourceSupportRankProfile matrix K ≤
      min K' (Module.finrank ℝ (columnSpan alternative Finset.univ)) := by
  apply sourceSupportRankProfile_le_of_forall
  exact sourceSupport_finrank_le_min_alternativeSparsity_rank
    matrix z f alternative alternativeCode hrich hfactors
      halternativeSparse halternativeFactors

/-- Part (a) under its minimal transparent rank premise: it is enough that
one source `K`-set is independent.  Full spark, or even independence of every
source `K`-set, is unnecessary. -/
theorem source_sparsity_le_effective_alternative_sparsity_of_exists_independent_support
    {X : Type*} {d M M' K K' : ℕ}
    (matrix : Matrix (Fin d) (Fin M) ℝ)
    (z : X → FeatureVector M) (f : X → RepresentationVector d)
    (alternative : Matrix (Fin d) (Fin M') ℝ)
    (alternativeCode : X → FeatureVector M')
    (hindependent : ∃ sourceSupport : Finset (Fin M),
      sourceSupport.card = K ∧
        LinearIndependent ℝ (selectedColumns matrix sourceSupport))
    (hrich : KRich (K := K) z)
    (hfactors : ∀ x, f x = matrix.mulVec (z x))
    (halternativeSparse : KSparse (K := K') alternativeCode)
    (halternativeFactors : ∀ x,
      f x = alternative.mulVec (alternativeCode x)) :
    K ≤ min K' M' := by
  obtain ⟨sourceSupport, hsource_card, hindependent⟩ := hindependent
  have hrank : Module.finrank ℝ (columnSpan matrix sourceSupport) = K := by
    calc
      Module.finrank ℝ (columnSpan matrix sourceSupport) =
          sourceSupport.card := by
        simpa [columnSpan] using finrank_span_eq_card hindependent
      _ = K := hsource_card
  rw [← hrank]
  exact sourceSupport_finrank_le_effective_alternative_sparsity
    matrix z f alternative alternativeCode hrich hfactors
      halternativeSparse halternativeFactors sourceSupport hsource_card

